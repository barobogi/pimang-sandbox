  "tours": [
    {
      "tour_name": "시흥 자연 힐링 시그니처 에어리얼 투어",
      "description": "갯골생태공원 → 은계생태공원 → 배곧한강공원 → 오이도빛거리 → 시화호 순으로 이어지는 경기도 시흥시의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "갯골생태공원",
        "은계생태공원",
        "배곧한강공원",
        "오이도빛거리",
        "시화호"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "시흥 자연 힐링 스카이 워크",
      "description": "시화호 → 갯골생태공원 → 배곧한강공원 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 시흥의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "시화호",
