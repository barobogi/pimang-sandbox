  "tours": [
    {
      "tour_name": "부평 자연 힐링 시그니처 에어리얼 투어",
      "description": "굴포천 → 부평공원 → 부평풍물거리 → 삼산동 쇼핑거리 → 만년산근린공원 순으로 이어지는 인천광역시 부평구의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "굴포천",
        "부평공원",
        "부평풍물거리",
        "삼산동 쇼핑거리",
        "만년산근린공원"
      ],
      "duration_hours": 3.5
    },
    {
      "tour_name": "부평 그린 랜드스케이프 플라이트",
      "description": "부평공원 → 굴포천 → 만년산근린공원 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 부평의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "부평공원",
        "굴포천",
        "만년산근린공원"
      ],
      "duration_hours": 2.5
