  "tours": [
    {
      "tour_name": "공주 역사·문화 시그니처 스카이 트레일",
      "description": "공주시장 → 무령왕릉 → 공산성 → 공주시청 → 마곡사 순으로 이어지는 충청남도 공주시의 대표 드론 플라이트 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "공주시장",
        "무령왕릉",
        "공산성",
        "공주시청",
        "마곡사"
      ],
      "duration_hours": 3.5
    },
    {
      "tour_name": "공주 세월을 나는 문화유산 플라이트",
      "description": "공산성 → 무령왕릉 → 마곡사 순의 역사·문화 집중 비행 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 공주의 역사·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "공산성",
        "무령왕릉",
        "마곡사"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "공주 도심 스카이라인 크루즈",
      "description": "공주시청 → 무령왕릉 → 공주시장 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 공주의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "공주시청",
