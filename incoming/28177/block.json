  "tours": [
    {
      "tour_name": "미추홀 도심 하이라이트 시그니처 스카이 투어",
      "description": "인천SSG랜더스필드 → 문학산 → 인하대학교 → 주안역 → 주안 로데오거리 순으로 이어지는 인천광역시 미추홀구의 대표 드론 플라이트 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "인천SSG랜더스필드",
        "문학산",
        "인하대학교",
        "주안역",
        "주안 로데오거리"
      ],
      "duration_hours": 3.5
    },
    {
      "tour_name": "미추홀 도심 스카이라인 크루즈",
      "description": "인천SSG랜더스필드 → 주안역 → 인하대학교 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 미추홀의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "인천SSG랜더스필드",
