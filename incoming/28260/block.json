  "tours": [
    {
      "tour_name": "서구 도심 하이라이트 시그니처 스카이 투어",
      "description": "청라국제도시 → 가좌동 상권 → 아라뱃길 → 검단신도시 → 오류동 갯벌체험장 순으로 이어지는 인천광역시 서구의 대표 드론 플라이트 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "청라국제도시",
        "가좌동 상권",
        "아라뱃길",
        "검단신도시",
        "오류동 갯벌체험장"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "서구 도심 활력 에어리얼 코스",
      "description": "청라국제도시 → 아라뱃길 → 검단신도시 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 서구의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "청라국제도시",
        "아라뱃길",
        "검단신도시"
      ],
      "duration_hours": 2.0
    }
  ],
