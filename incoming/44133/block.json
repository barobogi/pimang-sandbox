  "tours": [
    {
      "tour_name": "서북 도심 하이라이트 시그니처 스카이 투어",
      "description": "서북구청 → 두정동 상권 → 천안종합운동장 → 성거산 → 천안시립미술관 순으로 이어지는 충청남도 천안시 서북구의 대표 드론 플라이트 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "서북구청",
        "두정동 상권",
        "천안종합운동장",
        "성거산",
        "천안시립미술관"
      ],
      "duration_hours": 3.5
    },
    {
      "tour_name": "서북 도심 활력 에어리얼 코스",
      "description": "천안종합운동장 → 두정동 상권 → 서북구청 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 서북의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "천안종합운동장",
        "두정동 상권",
        "서북구청"
      ],
      "duration_hours": 2.0
    }
  ],
