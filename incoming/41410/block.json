  "tours": [
    {
      "tour_name": "군포 자연 힐링 시그니처 에어리얼 투어",
      "description": "수리산 → 군포공원 → 당정동 상권 → 금산동 상권 → 군포문화예술회관 순으로 이어지는 경기도 군포시의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "수리산",
        "군포공원",
        "당정동 상권",
        "금산동 상권",
        "군포문화예술회관"
      ],
      "duration_hours": 2.5
    },
    {
      "tour_name": "군포 그린 랜드스케이프 플라이트",
      "description": "수리산 → 군포공원 → 금산동 상권 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 군포의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "수리산",
        "군포공원",
        "금산동 상권"
      ],
      "duration_hours": 1.5
    },
    {
      "tour_name": "군포 도심 스카이라인 크루즈",
      "description": "군포문화예술회관 → 금산동 상권 → 당정동 상권 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 군포의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
