  "tours": [
    {
      "tour_name": "권선 도심 하이라이트 시그니처 스카이 투어",
      "description": "국립식량과학원 → 서둔공원 → 서둔천 → 권선동 상권 → 세류역 상권 순으로 이어지는 경기도 수원시 권선구의 대표 드론 플라이트 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "국립식량과학원",
        "서둔공원",
        "서둔천",
        "권선동 상권",
        "세류역 상권"
      ],
      "duration_hours": 2.5
    },
    {
      "tour_name": "권선 도심 활력 에어리얼 코스",
      "description": "국립식량과학원 → 권선동 상권 → 세류역 상권 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 권선의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "국립식량과학원",
        "권선동 상권",
        "세류역 상권"
      ],
      "duration_hours": 1.5
    },
    {
      "tour_name": "권선 산하 절경 에어리얼 투어",
      "description": "서둔천 → 서둔공원 → 국립식량과학원 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 권선의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "서둔천",
        "서둔공원",
        "국립식량과학원"
      ],
      "duration_hours": 1.5
    }
