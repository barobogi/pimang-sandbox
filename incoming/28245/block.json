  "tours": [
    {
      "tour_name": "계양 도심 하이라이트 시그니처 스카이 투어",
      "description": "계양문화예술회관 → 작전동 상권 → 계양산 → 계양천 → 계양역 신도시 순으로 이어지는 인천광역시 계양구의 대표 드론 플라이트 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "계양문화예술회관",
        "작전동 상권",
        "계양산",
        "계양천",
        "계양역 신도시"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "계양 도심 활력 에어리얼 코스",
      "description": "계양역 신도시 → 계양문화예술회관 → 작전동 상권 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 계양의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "계양역 신도시",
        "계양문화예술회관",
        "작전동 상권"
      ],
      "duration_hours": 1.5
    },
    {
      "tour_name": "계양 산하 절경 에어리얼 투어",
      "description": "계양천 → 계양산 → 작전동 상권 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 계양의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "계양천",
        "계양산",
        "작전동 상권"
      ],
      "duration_hours": 2.0
    }
