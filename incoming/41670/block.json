  "tours": [
    {
      "tour_name": "여주 역사·문화 시그니처 스카이 트레일",
      "description": "남한강 → 여주시청 → 여주시장 → 신륵사 → 세종대왕 영릉 순으로 이어지는 경기도 여주시의 대표 드론 플라이트 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "남한강",
        "여주시청",
        "여주시장",
        "신륵사",
        "세종대왕 영릉"
      ],
      "duration_hours": 4.0
    },
    {
      "tour_name": "여주 역사문화 스카이 트레일",
