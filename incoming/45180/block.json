  "tours": [
    {
      "tour_name": "정읍 자연 힐링 시그니처 에어리얼 투어",
      "description": "초정약수 → 고부모충사 → 내장산 → 내장사 → 정읍객사 순으로 이어지는 전북특별자치도 정읍시의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "초정약수",
        "고부모충사",
        "내장산",
        "내장사",
        "정읍객사"
      ],
      "duration_hours": 3.5
    },
    {
      "tour_name": "정읍 그린 랜드스케이프 플라이트",
      "description": "내장산 → 고부모충사 → 정읍객사 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 정읍의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "내장산",
        "고부모충사",
        "정읍객사"
      ],
      "duration_hours": 2.0
    }
  ],
