  "tours": [
    {
      "tour_name": "강진 역사·문화 시그니처 스카이 트레일",
      "description": "강진만 → 강진시장 → 강진군청 → 백련사 → 다산초당 순으로 이어지는 전라남도 강진군의 대표 드론 플라이트 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "강진만",
        "강진시장",
        "강진군청",
        "백련사",
        "다산초당"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "강진 역사문화 스카이 트레일",
      "description": "다산초당 → 백련사 → 강진만 순의 역사·문화 집중 비행 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 강진의 역사·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "다산초당",
        "백련사",
        "강진만"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "강진 자연 힐링 스카이 워크",
      "description": "강진만 → 강진시장 → 강진군청 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 강진의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "강진만",
