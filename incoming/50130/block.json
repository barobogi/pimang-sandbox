  "tours": [
    {
      "tour_name": "서귀포 자연 힐링 시그니처 에어리얼 투어",
      "description": "정방폭포 → 주상절리 대포지짐지형 → 천지연폭포 → 외돌개 → 성산일출봉 순으로 이어지는 제주특별자치도 서귀포시의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "정방폭포",
        "주상절리 대포지짐지형",
        "천지연폭포",
        "외돌개",
        "성산일출봉"
      ],
      "duration_hours": 4.0
    },
    {
      "tour_name": "서귀포 그린 랜드스케이프 플라이트",
      "description": "천지연폭포 → 주상절리 대포지짐지형 → 정방폭포 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 서귀포의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "천지연폭포",
        "주상절리 대포지짐지형",
        "정방폭포"
      ],
      "duration_hours": 1.5
    }
  ],
