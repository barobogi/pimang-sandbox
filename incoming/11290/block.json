  "tours": [
    {
      "tour_name": "성북 도심 하이라이트 시그니처 스카이 투어",
      "description": "정릉 → 성북동 → 서울성곽길 → 삼청동 → 고려대학교 순으로 이어지는 서울특별시 성북구의 대표 드론 플라이트 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "정릉",
        "성북동",
        "서울성곽길",
        "삼청동",
        "고려대학교"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "성북 도심 스카이라인 크루즈",
      "description": "고려대학교 → 성북동 → 삼청동 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 성북의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "고려대학교",
        "성북동",
        "삼청동"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "성북 세월을 나는 문화유산 플라이트",
      "description": "서울성곽길 → 성북동 → 정릉 순의 역사·문화 집중 비행 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 성북의 역사·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
