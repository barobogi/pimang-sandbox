  "tours": [
    {
      "tour_name": "삼척 자연 힐링 시그니처 에어리얼 투어",
      "description": "맹방해수욕장 → 죽서루 → 삼척시청 → 대금굴 → 환선굴 순으로 이어지는 강원특별자치도 삼척시의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "맹방해수욕장",
        "죽서루",
        "삼척시청",
        "대금굴",
        "환선굴"
      ],
      "duration_hours": 3.5
    },
    {
      "tour_name": "삼척 자연 힐링 스카이 워크",
      "description": "환선굴 → 대금굴 → 죽서루 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 삼척의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "환선굴",
