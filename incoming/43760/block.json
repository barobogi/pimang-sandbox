  "tours": [
    {
      "tour_name": "진천 도심 하이라이트 시그니처 스카이 투어",
      "description": "진천시장 → 진천군청 → 백곡저수지 → 생거진천거북이마을 → 농다리 순으로 이어지는 충청북도 진천군의 대표 드론 플라이트 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "진천시장",
        "진천군청",
        "백곡저수지",
        "생거진천거북이마을",
        "농다리"
      ],
      "duration_hours": 3.5
    },
    {
      "tour_name": "진천 도심 활력 에어리얼 코스",
      "description": "생거진천거북이마을 → 진천군청 → 진천시장 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 진천의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "생거진천거북이마을",
        "진천군청",
        "진천시장"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "진천 산하 절경 에어리얼 투어",
      "description": "농다리 → 진천시장 → 백곡저수지 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 진천의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "농다리",
        "진천시장",
