  "tours": [
    {
      "tour_name": "구로 자연 힐링 시그니처 에어리얼 투어",
      "description": "고척스카이돔 → 가산동 상권 → 구로디지털단지 → 구로공단 → 도림천 순으로 이어지는 서울특별시 구로구의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "고척스카이돔",
        "가산동 상권",
        "구로디지털단지",
        "구로공단",
        "도림천"
      ],
      "duration_hours": 2.5
    },
    {
      "tour_name": "구로 그린 랜드스케이프 플라이트",
      "description": "구로공단 → 구로디지털단지 → 도림천 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 구로의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "구로공단",
        "구로디지털단지",
        "도림천"
      ],
      "duration_hours": 1.5
    }
  ],
