  "tours": [
    {
      "tour_name": "충주 자연 힐링 시그니처 에어리얼 투어",
      "description": "탄금대공원 → 충주중앙탑 → 충주호 → 충주댐 → 월악산 순으로 이어지는 충청북도 충주시의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "탄금대공원",
        "충주중앙탑",
        "충주호",
        "충주댐",
        "월악산"
      ],
      "duration_hours": 3.5
    },
    {
      "tour_name": "충주 산하 절경 에어리얼 투어",
      "description": "탄금대공원 → 충주중앙탑 → 월악산 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 충주의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
