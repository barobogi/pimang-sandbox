  "tours": [
    {
      "tour_name": "김제 자연 힐링 시그니처 에어리얼 투어",
      "description": "벽골제 → 김제시장 → 김제시청 → 만경평야 → 금산사 순으로 이어지는 전북특별자치도 김제시의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "벽골제",
        "김제시장",
        "김제시청",
        "만경평야",
        "금산사"
      ],
      "duration_hours": 4.0
    },
    {
      "tour_name": "김제 산하 절경 에어리얼 투어",
      "description": "벽골제 → 김제시장 → 만경평야 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 김제의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "벽골제",
        "김제시장",
        "만경평야"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "김제 도심 활력 에어리얼 코스",
      "description": "김제시청 → 김제시장 → 벽골제 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 김제의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "김제시청",
