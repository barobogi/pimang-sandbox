  "tours": [
    {
      "tour_name": "중구 도심 하이라이트 시그니처 스카이 투어",
      "description": "N서울타워 → 명동 → 명동성당 → 덕수궁 → 동대문시장 순으로 이어지는 서울특별시 중구의 대표 드론 플라이트 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "N서울타워",
        "명동",
        "명동성당",
        "덕수궁",
        "동대문시장"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "중구 도심 스카이라인 크루즈",
      "description": "N서울타워 → 명동 → 동대문시장 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 중구의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "N서울타워",
