  "tours": [
    {
      "tour_name": "여수 자연 힐링 시그니처 에어리얼 투어",
      "description": "돌산공원 → 여수해상케이블카 → 거북선광장 → 이순신광장 → 오동도 순으로 이어지는 전라남도 여수시의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "돌산공원",
        "여수해상케이블카",
        "거북선광장",
        "이순신광장",
        "오동도"
      ],
      "duration_hours": 2.5
    },
    {
      "tour_name": "여수 자연 힐링 스카이 워크",
      "description": "돌산공원 → 여수해상케이블카 → 거북선광장 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 여수의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "돌산공원",
