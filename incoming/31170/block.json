  "tours": [
    {
      "tour_name": "동구 자연 힐링 시그니처 에어리얼 투어",
      "description": "미포해변 → 정자해수욕장 → 화암공원 → 강동공원 → 현대자동차 울산공장 순으로 이어지는 울산광역시 동구의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "미포해변",
        "정자해수욕장",
        "화암공원",
        "강동공원",
        "현대자동차 울산공장"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "동구 그린 랜드스케이프 플라이트",
      "description": "현대자동차 울산공장 → 화암공원 → 강동공원 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 동구의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "현대자동차 울산공장",
        "화암공원",
        "강동공원"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "동구 푸른 해안선 에어리얼 크루즈",
      "description": "미포해변 → 정자해수욕장 → 화암공원 순의 해안 집중 비행 코스. 파도 소리와 함께 해안선의 절경을 낮게 스치듯 비행하며, 동구의 해안 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "미포해변",
        "정자해수욕장",
        "화암공원"
      ],
      "duration_hours": 2.0
    }
