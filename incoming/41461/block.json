  "tours": [
    {
      "tour_name": "처인 자연 힐링 시그니처 에어리얼 투어",
      "description": "보개산 → 윤봉길 의사 유적 → 에버랜드 → 캐리비안베이 → 용인 자연휴양림 순으로 이어지는 경기도 용인시 처인구의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "보개산",
        "윤봉길 의사 유적",
        "에버랜드",
        "캐리비안베이",
        "용인 자연휴양림"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "처인 그린 랜드스케이프 플라이트",
      "description": "보개산 → 윤봉길 의사 유적 → 용인 자연휴양림 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 처인의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "보개산",
        "윤봉길 의사 유적",
        "용인 자연휴양림"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "처인 도심 스카이라인 크루즈",
      "description": "캐리비안베이 → 에버랜드 → 윤봉길 의사 유적 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 처인의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "캐리비안베이",
        "에버랜드",
        "윤봉길 의사 유적"
      ],
      "duration_hours": 2.0
    }
  ],
