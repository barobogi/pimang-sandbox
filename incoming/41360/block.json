  "tours": [
    {
      "tour_name": "남양주 도심 하이라이트 시그니처 스카이 투어",
      "description": "마석역 상권 → 남한강 → 다산신도시 → 별내신도시 → 사릉역 상권 순으로 이어지는 경기도 남양주시의 대표 드론 플라이트 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "마석역 상권",
        "남한강",
        "다산신도시",
        "별내신도시",
        "사릉역 상권"
      ],
      "duration_hours": 3.5
    },
    {
      "tour_name": "남양주 도심 활력 에어리얼 코스",
      "description": "마석역 상권 → 별내신도시 → 사릉역 상권 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 남양주의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "마석역 상권",
        "별내신도시",
        "사릉역 상권"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "남양주 산하 절경 에어리얼 투어",
      "description": "남한강 → 다산신도시 → 별내신도시 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 남양주의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "남한강",
        "다산신도시",
        "별내신도시"
      ],
      "duration_hours": 2.5
    }
