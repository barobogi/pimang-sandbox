  "tours": [
    {
      "tour_name": "부안 해안 절경 시그니처 드론 플라이트",
      "description": "채석강 → 변산반도국립공원 → 내소사 → 고선재 → 선유도 순으로 이어지는 전북특별자치도 부안군의 대표 드론 플라이트 코스. 파도 소리와 함께 해안선의 절경을 낮게 스치듯 비행하며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "채석강",
        "변산반도국립공원",
        "내소사",
        "고선재",
        "선유도"
      ],
      "duration_hours": 4.5
    },
    {
      "tour_name": "부안 바다빛 스카이 세일",
      "description": "고선재 → 채석강 → 선유도 순의 해안 집중 비행 코스. 파도 소리와 함께 해안선의 절경을 낮게 스치듯 비행하며, 부안의 해안 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "고선재",
