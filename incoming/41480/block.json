  "tours": [
    {
      "tour_name": "파주 자연 힐링 시그니처 에어리얼 투어",
      "description": "임진각평화누리 → 도라전망대 → 헤이리문화마을 → 운정호수공원 → 감악산 순으로 이어지는 경기도 파주시의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "임진각평화누리",
        "도라전망대",
        "헤이리문화마을",
        "운정호수공원",
        "감악산"
      ],
      "duration_hours": 4.5
    },
    {
      "tour_name": "파주 그린 랜드스케이프 플라이트",
      "description": "운정호수공원 → 헤이리문화마을 → 감악산 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 파주의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "운정호수공원",
        "헤이리문화마을",
        "감악산"
      ],
      "duration_hours": 2.5
    },
    {
      "tour_name": "파주 도심 스카이라인 크루즈",
      "description": "도라전망대 → 임진각평화누리 → 헤이리문화마을 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 파주의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "도라전망대",
        "임진각평화누리",
        "헤이리문화마을"
      ],
      "duration_hours": 2.5
    }
