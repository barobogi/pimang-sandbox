  "tours": [
    {
      "tour_name": "노원 역사·문화 시그니처 스카이 트레일",
      "description": "북서울미술관 → 노원문화예술회관 → 중계본동 시장 → 광운대학교 → 수락산 순으로 이어지는 서울특별시 노원구의 대표 드론 플라이트 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "북서울미술관",
        "노원문화예술회관",
        "중계본동 시장",
        "광운대학교",
        "수락산"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "노원 세월을 나는 문화유산 플라이트",
      "description": "북서울미술관 → 노원문화예술회관 → 중계본동 시장 순의 역사·문화 집중 비행 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 노원의 역사·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "북서울미술관",
