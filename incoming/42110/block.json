  "tours": [
    {
      "tour_name": "춘천 도심 하이라이트 시그니처 스카이 투어",
      "description": "춘천 명동 → 의암호 → 춘천인형극장 → 삼악산 → 남이섬 순으로 이어지는 강원특별자치도 춘천시의 대표 드론 플라이트 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "춘천 명동",
        "의암호",
        "춘천인형극장",
        "삼악산",
        "남이섬"
      ],
      "duration_hours": 3.5
    },
    {
      "tour_name": "춘천 도심 활력 에어리얼 코스",
      "description": "남이섬 → 춘천 명동 → 춘천인형극장 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 춘천의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "남이섬",
        "춘천 명동",
        "춘천인형극장"
      ],
      "duration_hours": 2.5
    },
    {
      "tour_name": "춘천 산하 절경 에어리얼 투어",
      "description": "삼악산 → 의암호 → 춘천 명동 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 춘천의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
