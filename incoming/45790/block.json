  "tours": [
    {
      "tour_name": "고창 역사·문화 시그니처 스카이 트레일",
      "description": "고창시장 → 선운사 → 고창고인돌유적 → 고창군청 → 고창읍성 순으로 이어지는 전북특별자치도 고창군의 대표 드론 플라이트 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "고창시장",
        "선운사",
        "고창고인돌유적",
        "고창군청",
        "고창읍성"
      ],
      "duration_hours": 3.5
    },
    {
      "tour_name": "고창 세월을 나는 문화유산 플라이트",
      "description": "고창읍성 → 고창고인돌유적 → 선운사 순의 역사·문화 집중 비행 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 고창의 역사·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "고창읍성",
        "고창고인돌유적",
        "선운사"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "고창 도심 스카이라인 크루즈",
      "description": "고창시장 → 고창군청 → 고창읍성 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 고창의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
