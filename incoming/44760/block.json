  "tours": [
    {
      "tour_name": "부여 역사·문화 시그니처 스카이 트레일",
      "description": "궁남지 → 부여군청 → 정림사지 → 부소산성 → 낙화암 순으로 이어지는 충청남도 부여군의 대표 드론 플라이트 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "궁남지",
        "부여군청",
        "정림사지",
        "부소산성",
        "낙화암"
      ],
      "duration_hours": 2.5
    },
    {
      "tour_name": "부여 고즈넉한 역사 스카이 산책",
      "description": "낙화암 → 부소산성 → 정림사지 순의 역사·문화 집중 비행 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 부여의 역사·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "낙화암",
