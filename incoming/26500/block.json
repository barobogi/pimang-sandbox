  "tours": [
    {
      "tour_name": "수영 자연 힐링 시그니처 에어리얼 투어",
      "description": "광안대교 → 광안리해수욕장 → 황령산 → 수영사적공원 → 민락수변공원 순으로 이어지는 부산광역시 수영구의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "광안대교",
        "광안리해수욕장",
        "황령산",
        "수영사적공원",
        "민락수변공원"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "수영 산하 절경 에어리얼 투어",
      "description": "민락수변공원 → 수영사적공원 → 황령산 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 수영의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "민락수변공원",
        "수영사적공원",
        "황령산"
      ],
      "duration_hours": 2.0
    }
  ],
