  "tours": [
    {
      "tour_name": "신안 해안 절경 시그니처 드론 플라이트",
      "description": "흑산도 → 홍도 → 비금도 → 도초도 → 증도 순으로 이어지는 전라남도 신안군의 대표 드론 플라이트 코스. 파도 소리와 함께 해안선의 절경을 낮게 스치듯 비행하며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "흑산도",
        "홍도",
        "비금도",
        "도초도",
        "증도"
      ],
      "duration_hours": 4.5
    },
    {
      "tour_name": "신안 푸른 해안선 에어리얼 크루즈",
      "description": "홍도 → 흑산도 → 증도 순의 해안 집중 비행 코스. 파도 소리와 함께 해안선의 절경을 낮게 스치듯 비행하며, 신안의 해안 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "홍도",
        "흑산도",
        "증도"
      ],
      "duration_hours": 4.5
    }
  ],
