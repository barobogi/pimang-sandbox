  "tours": [
    {
      "tour_name": "양주 도심 하이라이트 시그니처 스카이 투어",
      "description": "양주공원 → 광사동 상권 → 양주역 상권 → 천보산 → 옥정지구 순으로 이어지는 경기도 양주시의 대표 드론 플라이트 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "양주공원",
        "광사동 상권",
        "양주역 상권",
        "천보산",
        "옥정지구"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "양주 도심 스카이라인 크루즈",
      "description": "옥정지구 → 광사동 상권 → 양주역 상권 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 양주의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "옥정지구",
        "광사동 상권",
        "양주역 상권"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "양주 그린 랜드스케이프 플라이트",
      "description": "천보산 → 양주역 상권 → 양주공원 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 양주의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "천보산",
