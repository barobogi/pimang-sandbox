  "tours": [
    {
      "tour_name": "영도 역사·문화 시그니처 스카이 트레일",
      "description": "태종대 → 현대미포조선소 → 봉래산 → 흰여울문화마을 → 영도대교 순으로 이어지는 부산광역시 영도구의 대표 드론 플라이트 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "태종대",
        "현대미포조선소",
        "봉래산",
        "흰여울문화마을",
        "영도대교"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "영도 세월을 나는 문화유산 플라이트",
      "description": "영도대교 → 흰여울문화마을 → 봉래산 순의 역사·문화 집중 비행 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 영도의 역사·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "영도대교",
        "흰여울문화마을",
        "봉래산"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "영도 그린 랜드스케이프 플라이트",
      "description": "현대미포조선소 → 봉래산 → 흰여울문화마을 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 영도의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
