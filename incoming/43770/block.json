          "Suanbo Hot Springs",
          "Eumseong's signature hot spring destination with a spa park and resort complex."
        ],
        "설성공원": [
          "Seolseong Park",
          "Central park of Eumseong-eup with Gyeonghojeong Pavilion and a pond, hosting the National Pumbaa Festival."
        ],
        "미타사": [
          "Mitasа Temple",
          "Traditional temple in Baegya-ri, Geumwang-eup, preserving a three-story stone pagoda and a Buddha rock carving."
        ]
      }
    },
    "ja": {
      "block_name": "忠清北道 陰城郡",
      "landmarks": {
        "감곡매괴성모순례지성당": [
          "甘谷梅孤聖母巡礼地聖堂",
