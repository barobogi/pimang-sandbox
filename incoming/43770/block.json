        ],
        "설성공원": [
          "雪城公園",
          "陰城邑中心部の公園。慶湖亭と池があり、全国品バ祭りが開かれる。"
        ],
        "미타사": [
          "弥陀寺",
          "金旺面白也里の伝統寺院。三層石塔と磨崖如来立像などの文化遺産が伝わる。"
        ]
      }
    },
