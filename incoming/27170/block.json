  "tours": [
    {
      "tour_name": "서구 자연 힐링 시그니처 에어리얼 투어",
      "description": "이현공원 → 서대구역 → 와룡산 → 초록꽃마당 → 만물백화점 순으로 이어지는 대구광역시 서구의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "이현공원",
        "서대구역",
        "와룡산",
        "초록꽃마당",
        "만물백화점"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "서구 그린 랜드스케이프 플라이트",
      "description": "와룡산 → 이현공원 → 초록꽃마당 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 서구의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "와룡산",
        "이현공원",
        "초록꽃마당"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "서구 도심 스카이라인 크루즈",
      "description": "만물백화점 → 서대구역 → 이현공원 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 서구의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "만물백화점",
        "서대구역",
        "이현공원"
      ],
      "duration_hours": 2.0
    }
  ],
