  "tours": [
    {
      "tour_name": "일산동 자연 힐링 시그니처 에어리얼 투어",
      "description": "중산공원 → 라페스타 → 일산호수공원 → 정발산 → 킨텍스 순으로 이어지는 경기도 고양시 일산동구의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "중산공원",
        "라페스타",
        "일산호수공원",
        "정발산",
        "킨텍스"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "일산동 산하 절경 에어리얼 투어",
      "description": "일산호수공원 → 정발산 → 중산공원 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 일산동의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "일산호수공원",
        "정발산",
        "중산공원"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "일산동 도심 활력 에어리얼 코스",
      "description": "킨텍스 → 라페스타 → 일산호수공원 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 일산동의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "킨텍스",
