  "tours": [
    {
      "tour_name": "완도 해안 절경 시그니처 드론 플라이트",
      "description": "소안도 → 보길도 → 금등해수욕장 → 신지도 → 청산도 순으로 이어지는 전라남도 완도군의 대표 드론 플라이트 코스. 파도 소리와 함께 해안선의 절경을 낮게 스치듯 비행하며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "소안도",
        "보길도",
        "금등해수욕장",
        "신지도",
        "청산도"
      ],
      "duration_hours": 4.5
    },
    {
      "tour_name": "완도 바다빛 스카이 세일",
      "description": "신지도 → 소안도 → 보길도 순의 해안 집중 비행 코스. 파도 소리와 함께 해안선의 절경을 낮게 스치듯 비행하며, 완도의 해안 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "신지도",
        "소안도",
        "보길도"
      ],
      "duration_hours": 3.0
    }
