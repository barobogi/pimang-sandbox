          "National ecological research body with greenhouses of the world's five climate zones."
        ],
        "금강하굿둑 철새도래지": [
          "Geum River Estuary Migratory Bird Sanctuary",
          "Premier estuary bird sanctuary drawing some 500,000 birds of 40-plus species each winter."
        ],
        "문헌서원": [
          "Munheonseowon Confucian Academy",
          "Royal-chartered seowon honoring Yi Gok and Yi Saek, famed for its crape myrtle scenery."
        ]
      }
