  "tours": [
    {
      "tour_name": "동대문 역사·문화 시그니처 스카이 트레일",
      "description": "서울시립대학교 → 경동시장 → 동대문종합시장 → 동대문현대시티 → 동대문디자인플라자 순으로 이어지는 서울특별시 동대문구의 대표 드론 플라이트 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "서울시립대학교",
        "경동시장",
        "동대문종합시장",
        "동대문현대시티",
        "동대문디자인플라자"
      ],
      "duration_hours": 2.5
    },
