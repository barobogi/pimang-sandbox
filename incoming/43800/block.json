  "tours": [
    {
      "tour_name": "단양 자연 힐링 시그니처 에어리얼 투어",
      "description": "단양시장 → 고수동굴 → 단양군청 → 도담삼봉 → 구인사 순으로 이어지는 충청북도 단양군의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "단양시장",
        "고수동굴",
        "단양군청",
        "도담삼봉",
        "구인사"
      ],
      "duration_hours": 3.5
    },
    {
      "tour_name": "단양 그린 랜드스케이프 플라이트",
      "description": "도담삼봉 → 단양군청 → 고수동굴 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 단양의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "도담삼봉",
        "단양군청",
        "고수동굴"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "단양 도심 스카이라인 크루즈",
      "description": "단양군청 → 고수동굴 → 단양시장 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 단양의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "단양군청",
