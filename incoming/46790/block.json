  "tours": [
    {
      "tour_name": "화순 역사·문화 시그니처 스카이 트레일",
      "description": "화순고인돌유적 → 화순시장 → 화순군청 → 화순적벽 → 운주사 순으로 이어지는 전라남도 화순군의 대표 드론 플라이트 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "화순고인돌유적",
        "화순시장",
        "화순군청",
        "화순적벽",
        "운주사"
      ],
      "duration_hours": 4.0
    },
    {
      "tour_name": "화순 세월을 나는 문화유산 플라이트",
      "description": "운주사 → 화순고인돌유적 → 화순시장 순의 역사·문화 집중 비행 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 화순의 역사·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "운주사",
