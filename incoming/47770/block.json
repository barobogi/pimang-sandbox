  "tours": [
    {
      "tour_name": "영덕 해안 절경 시그니처 드론 플라이트",
      "description": "오십천 → 영덕군청 → 영덕시장 → 강구항 → 영덕해맞이공원 순으로 이어지는 경상북도 영덕군의 대표 드론 플라이트 코스. 파도 소리와 함께 해안선의 절경을 낮게 스치듯 비행하며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "오십천",
        "영덕군청",
        "영덕시장",
        "강구항",
        "영덕해맞이공원"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "영덕 푸른 해안선 에어리얼 크루즈",
      "description": "강구항 → 영덕시장 → 영덕해맞이공원 순의 해안 집중 비행 코스. 파도 소리와 함께 해안선의 절경을 낮게 스치듯 비행하며, 영덕의 해안 매력을 밀도 있게 만나는 3스톱 투어다.",
