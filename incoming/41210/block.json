  "tours": [
    {
      "tour_name": "광명 자연 힐링 시그니처 에어리얼 투어",
      "description": "하안근린공원 → 철산동 상권 → 광명사거리 상권 → 오리공원 → 광명동굴 순으로 이어지는 경기도 광명시의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "하안근린공원",
        "철산동 상권",
        "광명사거리 상권",
        "오리공원",
        "광명동굴"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "광명 그린 랜드스케이프 플라이트",
      "description": "철산동 상권 → 하안근린공원 → 오리공원 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 광명의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "철산동 상권",
        "하안근린공원",
        "오리공원"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "광명 도심 스카이라인 크루즈",
      "description": "광명동굴 → 오리공원 → 광명사거리 상권 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 광명의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "광명동굴",
        "오리공원",
        "광명사거리 상권"
      ],
      "duration_hours": 2.0
    }
  ],
