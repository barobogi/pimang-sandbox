  "tours": [
    {
      "tour_name": "태안 해안 절경 시그니처 드론 플라이트",
      "description": "태안해안국립공원 → 만리포해수욕장 → 태안군청 → 안면도 → 꽃지해수욕장 순으로 이어지는 충청남도 태안군의 대표 드론 플라이트 코스. 파도 소리와 함께 해안선의 절경을 낮게 스치듯 비행하며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "태안해안국립공원",
        "만리포해수욕장",
        "태안군청",
        "안면도",
        "꽃지해수욕장"
      ],
      "duration_hours": 4.5
    },
    {
      "tour_name": "태안 해안 절경 드론 플라이트",
      "description": "꽃지해수욕장 → 안면도 → 만리포해수욕장 순의 해안 집중 비행 코스. 파도 소리와 함께 해안선의 절경을 낮게 스치듯 비행하며, 태안의 해안 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "꽃지해수욕장",
        "안면도",
        "만리포해수욕장"
      ],
      "duration_hours": 3.0
    }
  ],
