  "tours": [
    {
      "tour_name": "곡성 역사·문화 시그니처 스카이 트레일",
      "description": "동악산 → 곡성군청 → 곡성시장 → 섬진강기차마을 → 태안사 순으로 이어지는 전라남도 곡성군의 대표 드론 플라이트 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "동악산",
        "곡성군청",
        "곡성시장",
        "섬진강기차마을",
        "태안사"
      ],
      "duration_hours": 3.5
    },
    {
      "tour_name": "곡성 세월을 나는 문화유산 플라이트",
      "description": "태안사 → 섬진강기차마을 → 곡성군청 순의 역사·문화 집중 비행 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 곡성의 역사·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
