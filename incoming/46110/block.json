  "tours": [
    {
      "tour_name": "목포 역사·문화 시그니처 스카이 트레일",
      "description": "목포해상케이블카 → 유달산 → 목포근대역사관 → 삼학도 → 국립해양유물전시관 순으로 이어지는 전라남도 목포시의 대표 드론 플라이트 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "목포해상케이블카",
        "유달산",
        "목포근대역사관",
        "삼학도",
        "국립해양유물전시관"
      ],
      "duration_hours": 2.5
    },
    {
      "tour_name": "목포 세월을 나는 문화유산 플라이트",
      "description": "국립해양유물전시관 → 삼학도 → 목포근대역사관 순의 역사·문화 집중 비행 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 목포의 역사·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "국립해양유물전시관",
        "삼학도",
