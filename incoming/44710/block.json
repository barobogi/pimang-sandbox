  "tours": [
    {
      "tour_name": "금산 자연 힐링 시그니처 에어리얼 투어",
      "description": "금산군청 → 금산인삼시장 → 금산인삼관 → 진악산 → 적벽강 순으로 이어지는 충청남도 금산군의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "금산군청",
        "금산인삼시장",
        "금산인삼관",
        "진악산",
        "적벽강"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "금산 그린 랜드스케이프 플라이트",
      "description": "적벽강 → 금산군청 → 진악산 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 금산의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "적벽강",
        "금산군청",
        "진악산"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "금산 도심 스카이라인 크루즈",
      "description": "금산인삼관 → 금산인삼시장 → 금산군청 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 금산의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "금산인삼관",
        "금산인삼시장",
        "금산군청"
      ],
      "duration_hours": 1.5
    }
  ],
