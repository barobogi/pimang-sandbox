  "tours": [
    {
      "tour_name": "완산 역사·문화 시그니처 스카이 트레일",
      "description": "남부시장 → 경기전 → 전동성당 → 오목대 → 전주한옥마을 순으로 이어지는 전북특별자치도 전주시 완산구의 대표 드론 플라이트 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "남부시장",
        "경기전",
        "전동성당",
        "오목대",
        "전주한옥마을"
      ],
      "duration_hours": 2.5
    },
    {
      "tour_name": "완산 세월을 나는 문화유산 플라이트",
      "description": "전주한옥마을 → 오목대 → 남부시장 순의 역사·문화 집중 비행 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 완산의 역사·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "전주한옥마을",
        "오목대",
        "남부시장"
      ],
      "duration_hours": 1.5
    },
    {
      "tour_name": "완산 그린 랜드스케이프 플라이트",
