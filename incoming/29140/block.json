  "tours": [
    {
      "tour_name": "서구 자연 힐링 시그니처 에어리얼 투어",
      "description": "황룡강 → 서구문화예술회관 → 유스퀘어 → 풍암호수공원 → 상무지구 순으로 이어지는 광주광역시 서구의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "황룡강",
        "서구문화예술회관",
        "유스퀘어",
        "풍암호수공원",
        "상무지구"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "서구 자연 힐링 스카이 워크",
      "description": "풍암호수공원 → 황룡강 → 유스퀘어 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 서구의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "풍암호수공원",
        "황룡강",
        "유스퀘어"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "서구 도심 하이라이트 스카이 투어",
      "description": "상무지구 → 황룡강 → 유스퀘어 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 서구의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
