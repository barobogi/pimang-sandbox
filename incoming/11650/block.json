  "tours": [
    {
      "tour_name": "서초 도심 하이라이트 시그니처 스카이 투어",
      "description": "양재동 상권 → 법조타운 → 서래마을 → 반포한강공원 → 우면산 순으로 이어지는 서울특별시 서초구의 대표 드론 플라이트 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "양재동 상권",
        "법조타운",
        "서래마을",
        "반포한강공원",
        "우면산"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "서초 도심 스카이라인 크루즈",
      "description": "서래마을 → 법조타운 → 양재동 상권 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 서초의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "서래마을",
        "법조타운",
        "양재동 상권"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "서초 그린 랜드스케이프 플라이트",
      "description": "반포한강공원 → 서래마을 → 우면산 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 서초의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
