  "tours": [
    {
      "tour_name": "동구 역사·문화 시그니처 스카이 트레일",
      "description": "증심사 → 무등산 → 동명동 → 국립아시아문화전당 → 충장로 순으로 이어지는 광주광역시 동구의 대표 드론 플라이트 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "증심사",
        "무등산",
        "동명동",
        "국립아시아문화전당",
        "충장로"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "동구 고즈넉한 역사 스카이 산책",
      "description": "증심사 → 국립아시아문화전당 → 충장로 순의 역사·문화 집중 비행 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 동구의 역사·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "증심사",
        "국립아시아문화전당",
        "충장로"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "동구 도심 활력 에어리얼 코스",
      "description": "동명동 → 국립아시아문화전당 → 충장로 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 동구의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
