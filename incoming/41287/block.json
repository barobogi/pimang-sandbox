  "tours": [
    {
      "tour_name": "일산서 자연 힐링 시그니처 에어리얼 투어",
      "description": "킨텍스 → 대화동 상권 → 일산호수공원 → 고양아람누리 → 일산역 상권 순으로 이어지는 경기도 고양시 일산서구의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "킨텍스",
        "대화동 상권",
        "일산호수공원",
        "고양아람누리",
        "일산역 상권"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "일산서 산하 절경 에어리얼 투어",
      "description": "일산호수공원 → 고양아람누리 → 일산역 상권 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 일산서의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "일산호수공원",
        "고양아람누리",
        "일산역 상권"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "일산서 도심 활력 에어리얼 코스",
      "description": "킨텍스 → 대화동 상권 → 일산호수공원 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 일산서의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "킨텍스",
        "대화동 상권",
        "일산호수공원"
      ],
      "duration_hours": 1.5
    }
  ],
