  "tours": [
    {
      "tour_name": "분당 자연 힐링 시그니처 에어리얼 투어",
      "description": "정자동 상권 → 분당중앙공원 → 수내공원 → 판교테크노밸리 → 야탑역 상권 순으로 이어지는 경기도 성남시 분당구의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "정자동 상권",
        "분당중앙공원",
        "수내공원",
        "판교테크노밸리",
        "야탑역 상권"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "분당 그린 랜드스케이프 플라이트",
      "description": "판교테크노밸리 → 분당중앙공원 → 수내공원 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 분당의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "판교테크노밸리",
        "분당중앙공원",
        "수내공원"
      ],
      "duration_hours": 2.0
    }
  ],
