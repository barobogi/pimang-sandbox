  "tours": [
    {
      "tour_name": "정선 자연 힐링 시그니처 에어리얼 투어",
      "description": "정선시장 → 화암동굴 → 정선군청 → 동강 → 정암사 순으로 이어지는 강원특별자치도 정선군의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "정선시장",
        "화암동굴",
        "정선군청",
        "동강",
        "정암사"
      ],
      "duration_hours": 4.5
    },
    {
      "tour_name": "정선 자연 힐링 스카이 워크",
      "description": "화암동굴 → 정선시장 → 동강 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 정선의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "화암동굴",
