  "tours": [
    {
      "tour_name": "강남 자연 힐링 시그니처 에어리얼 투어",
      "description": "테헤란로 → 강남역 → 가로수길 → 도산공원 → 청담동 순으로 이어지는 서울특별시 강남구의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "테헤란로",
        "강남역",
        "가로수길",
        "도산공원",
        "청담동"
      ],
      "duration_hours": 2.5
    },
    {
      "tour_name": "강남 그린 랜드스케이프 플라이트",
      "description": "강남역 → 테헤란로 → 도산공원 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 강남의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "강남역",
        "테헤란로",
        "도산공원"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "강남 도심 스카이라인 크루즈",
      "description": "청담동 → 도산공원 → 테헤란로 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 강남의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "청담동",
        "도산공원",
        "테헤란로"
      ],
      "duration_hours": 2.0
    }
