  "tours": [
    {
      "tour_name": "흥덕 도심 하이라이트 시그니처 스카이 투어",
      "description": "사직공원 → 흥덕구청 → 공원 → 충북대학교 → 무심천 순으로 이어지는 충청북도 청주시 흥덕구의 대표 드론 플라이트 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "사직공원",
        "흥덕구청",
        "공원",
        "충북대학교",
        "무심천"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "흥덕 도심 하이라이트 스카이 투어",
      "description": "충북대학교 → 공원 → 흥덕구청 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 흥덕의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "충북대학교",
