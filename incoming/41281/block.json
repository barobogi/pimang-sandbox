  "tours": [
    {
      "tour_name": "덕양 자연 힐링 시그니처 에어리얼 투어",
      "description": "창릉천 → 덕은공원 → 화정동 상권 → 고양시청 → 행주산성 순으로 이어지는 경기도 고양시 덕양구의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "창릉천",
        "덕은공원",
        "화정동 상권",
        "고양시청",
        "행주산성"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "덕양 그린 랜드스케이프 플라이트",
      "description": "행주산성 → 덕은공원 → 창릉천 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 덕양의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "행주산성",
        "덕은공원",
        "창릉천"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "덕양 도심 스카이라인 크루즈",
      "description": "고양시청 → 화정동 상권 → 덕은공원 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 덕양의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "고양시청",
