  "tours": [
    {
      "tour_name": "청양 자연 힐링 시그니처 에어리얼 투어",
      "description": "칠갑산자연휴양림 → 장승공원 → 칠갑산 → 청양시장 → 청양군청 순으로 이어지는 충청남도 청양군의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "칠갑산자연휴양림",
        "장승공원",
        "칠갑산",
        "청양시장",
        "청양군청"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "청양 산하 절경 에어리얼 투어",
      "description": "칠갑산 → 장승공원 → 칠갑산자연휴양림 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 청양의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "칠갑산",
        "장승공원",
        "칠갑산자연휴양림"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "청양 도심 활력 에어리얼 코스",
      "description": "청양군청 → 청양시장 → 칠갑산자연휴양림 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 청양의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "청양군청",
        "청양시장",
        "칠갑산자연휴양림"
      ],
      "duration_hours": 2.0
    }
  ],
