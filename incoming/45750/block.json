  "tours": [
    {
      "tour_name": "임실 도심 하이라이트 시그니처 스카이 투어",
      "description": "임실시장 → 임실군청 → 임실치즈테마파크 → 성수산 → 옥정호 순으로 이어지는 전북특별자치도 임실군의 대표 드론 플라이트 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "임실시장",
        "임실군청",
        "임실치즈테마파크",
        "성수산",
        "옥정호"
      ],
      "duration_hours": 3.5
    },
    {
      "tour_name": "임실 도심 하이라이트 스카이 투어",
      "description": "임실치즈테마파크 → 임실군청 → 임실시장 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 임실의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "임실치즈테마파크",
        "임실군청",
        "임실시장"
      ],
      "duration_hours": 1.5
    },
    {
      "tour_name": "임실 자연 힐링 스카이 워크",
      "description": "옥정호 → 성수산 → 임실시장 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 임실의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "옥정호",
