  "tours": [
    {
      "tour_name": "영등포 자연 힐링 시그니처 에어리얼 투어",
      "description": "영등포시장 → 국회의사당 → 여의도공원 → 여의도한강공원 → 63빌딩 순으로 이어지는 서울특별시 영등포구의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "영등포시장",
        "국회의사당",
        "여의도공원",
        "여의도한강공원",
        "63빌딩"
      ],
      "duration_hours": 2.5
    },
    {
      "tour_name": "영등포 그린 랜드스케이프 플라이트",
      "description": "여의도한강공원 → 여의도공원 → 국회의사당 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 영등포의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "여의도한강공원",
        "여의도공원",
        "국회의사당"
      ],
      "duration_hours": 1.5
    },
    {
      "tour_name": "영등포 도심 스카이라인 크루즈",
      "description": "국회의사당 → 여의도공원 → 63빌딩 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 영등포의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "국회의사당",
        "여의도공원",
        "63빌딩"
      ],
      "duration_hours": 1.5
    }
