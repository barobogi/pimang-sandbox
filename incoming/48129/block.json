  "tours": [
    {
      "tour_name": "진해 자연 힐링 시그니처 에어리얼 투어",
      "description": "진해구청 → 경화역 → 여좌천 → 진해해군기지 → 진해만 순으로 이어지는 경상남도 창원시 진해구의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "진해구청",
        "경화역",
        "여좌천",
        "진해해군기지",
        "진해만"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "진해 산하 절경 에어리얼 투어",
      "description": "여좌천 → 경화역 → 진해만 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 진해의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "여좌천",
        "경화역",
        "진해만"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "진해 도심 활력 에어리얼 코스",
      "description": "진해구청 → 진해해군기지 → 여좌천 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 진해의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "진해구청",
        "진해해군기지",
        "여좌천"
      ],
      "duration_hours": 2.0
    }
  ],
