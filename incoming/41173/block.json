  "tours": [
    {
      "tour_name": "동안 도심 하이라이트 시그니처 스카이 투어",
      "description": "호계동 상권 → 비산공원 → 관양동 상권 → 평촌 상권 → 평촌중앙공원 순으로 이어지는 경기도 안양시 동안구의 대표 드론 플라이트 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "호계동 상권",
        "비산공원",
        "관양동 상권",
        "평촌 상권",
        "평촌중앙공원"
      ],
      "duration_hours": 2.5
    },
    {
      "tour_name": "동안 도심 스카이라인 크루즈",
      "description": "관양동 상권 → 평촌 상권 → 호계동 상권 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 동안의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "관양동 상권",
        "평촌 상권",
        "호계동 상권"
      ],
      "duration_hours": 1.5
    },
    {
      "tour_name": "동안 그린 랜드스케이프 플라이트",
      "description": "평촌중앙공원 → 평촌 상권 → 비산공원 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 동안의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "평촌중앙공원",
        "평촌 상권",
        "비산공원"
      ],
      "duration_hours": 1.5
    }
  ],
