  "tours": [
    {
      "tour_name": "서원 역사·문화 시그니처 스카이 트레일",
      "description": "청주고인쇄박물관 → 서원대학교 → 청주시립미술관 → 서원구청 → 무심천 순으로 이어지는 충청북도 청주시 서원구의 대표 드론 플라이트 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "청주고인쇄박물관",
        "서원대학교",
        "청주시립미술관",
        "서원구청",
        "무심천"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "서원 역사문화 스카이 트레일",
      "description": "청주고인쇄박물관 → 서원대학교 → 서원구청 순의 역사·문화 집중 비행 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 서원의 역사·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "청주고인쇄박물관",
