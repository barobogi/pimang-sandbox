  "tours": [
    {
      "tour_name": "김해 자연 힐링 시그니처 에어리얼 투어",
      "description": "수어촌 → 국립김해박물관 → 가야테마파크 → 봉황공원 → 장유폭포 순으로 이어지는 경상남도 김해시의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "수어촌",
        "국립김해박물관",
        "가야테마파크",
        "봉황공원",
        "장유폭포"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "김해 자연 힐링 스카이 워크",
      "description": "봉황공원 → 가야테마파크 → 장유폭포 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 김해의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "봉황공원",
        "가야테마파크",
        "장유폭포"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "김해 역사문화 스카이 트레일",
      "description": "수어촌 → 국립김해박물관 → 가야테마파크 순의 역사·문화 집중 비행 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 김해의 역사·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
