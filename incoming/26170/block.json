  "tours": [
    {
      "tour_name": "동구 자연 힐링 시그니처 에어리얼 투어",
      "description": "동구청 → 범일동 벚꽃길 → 부산역 → 초량이바구길 → 부산항 북항 순으로 이어지는 부산광역시 동구의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "동구청",
        "범일동 벚꽃길",
        "부산역",
        "초량이바구길",
        "부산항 북항"
      ],
      "duration_hours": 2.5
    },
    {
      "tour_name": "동구 그린 랜드스케이프 플라이트",
      "description": "범일동 벚꽃길 → 부산역 → 초량이바구길 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 동구의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "범일동 벚꽃길",
        "부산역",
        "초량이바구길"
      ],
      "duration_hours": 1.5
    }
