  "tours": [
    {
      "tour_name": "평택 해안 절경 시그니처 드론 플라이트",
      "description": "평택항 → 동삭해수욕장 → 캠프험프리스 → 평택호수공원 → 평택문화예술회관 순으로 이어지는 경기도 평택시의 대표 드론 플라이트 코스. 파도 소리와 함께 해안선의 절경을 낮게 스치듯 비행하며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "평택항",
        "동삭해수욕장",
        "캠프험프리스",
        "평택호수공원",
        "평택문화예술회관"
      ],
      "duration_hours": 4.0
    },
    {
      "tour_name": "평택 바다빛 스카이 세일",
      "description": "동삭해수욕장 → 평택항 → 캠프험프리스 순의 해안 집중 비행 코스. 파도 소리와 함께 해안선의 절경을 낮게 스치듯 비행하며, 평택의 해안 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "동삭해수욕장",
        "평택항",
        "캠프험프리스"
      ],
      "duration_hours": 2.5
    },
    {
      "tour_name": "평택 도심 활력 에어리얼 코스",
      "description": "캠프험프리스 → 평택호수공원 → 평택문화예술회관 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 평택의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
