  "tours": [
    {
      "tour_name": "단원 해안 절경 시그니처 드론 플라이트",
      "description": "대부도 → 선감도 → 반월국가산업단지 → 와동 상권 → 안산호수공원 순으로 이어지는 경기도 안산시 단원구의 대표 드론 플라이트 코스. 파도 소리와 함께 해안선의 절경을 낮게 스치듯 비행하며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "대부도",
        "선감도",
        "반월국가산업단지",
        "와동 상권",
        "안산호수공원"
      ],
      "duration_hours": 3.5
    },
    {
      "tour_name": "단원 바다빛 스카이 세일",
      "description": "대부도 → 선감도 → 반월국가산업단지 순의 해안 집중 비행 코스. 파도 소리와 함께 해안선의 절경을 낮게 스치듯 비행하며, 단원의 해안 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "대부도",
        "선감도",
        "반월국가산업단지"
      ],
      "duration_hours": 2.5
    },
    {
      "tour_name": "단원 산하 절경 에어리얼 투어",
      "description": "안산호수공원 → 와동 상권 → 반월국가산업단지 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 단원의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "안산호수공원",
