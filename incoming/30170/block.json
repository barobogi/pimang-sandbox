  "tours": [
    {
      "tour_name": "서구 자연 힐링 시그니처 에어리얼 투어",
      "description": "장태산 → 갑천 → 둔산동 상권 → 대전예술의전당 → 한밭수목원 순으로 이어지는 대전광역시 서구의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "장태산",
        "갑천",
        "둔산동 상권",
        "대전예술의전당",
        "한밭수목원"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "서구 산하 절경 에어리얼 투어",
      "description": "한밭수목원 → 둔산동 상권 → 장태산 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 서구의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "한밭수목원",
        "둔산동 상권",
        "장태산"
      ],
      "duration_hours": 2.0
    }
