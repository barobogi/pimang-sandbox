  "tours": [
    {
      "tour_name": "순창 자연 힐링 시그니처 에어리얼 투어",
      "description": "강천산 → 순창고추장민속마을 → 순창군청 → 순창시장 → 회문산 순으로 이어지는 전북특별자치도 순창군의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "강천산",
        "순창고추장민속마을",
        "순창군청",
        "순창시장",
        "회문산"
      ],
      "duration_hours": 3.5
    },
    {
      "tour_name": "순창 자연 힐링 스카이 워크",
      "description": "회문산 → 강천산 → 순창고추장민속마을 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 순창의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "회문산",
        "강천산",
        "순창고추장민속마을"
      ],
      "duration_hours": 2.5
    },
    {
      "tour_name": "순창 도심 하이라이트 스카이 투어",
      "description": "순창시장 → 순창군청 → 순창고추장민속마을 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 순창의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "순창시장",
        "순창군청",
        "순창고추장민속마을"
      ],
      "duration_hours": 2.0
    }
