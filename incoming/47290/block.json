  "tours": [
    {
      "tour_name": "경산 자연 힐링 시그니처 에어리얼 투어",
      "description": "자인단오제전수교육관 → 영남대학교 → 남매탑 → 경산시청 → 경산시장 순으로 이어지는 경상북도 경산시의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "자인단오제전수교육관",
        "영남대학교",
        "남매탑",
        "경산시청",
        "경산시장"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "경산 그린 랜드스케이프 플라이트",
      "description": "남매탑 → 경산시청 → 경산시장 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 경산의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "남매탑",
        "경산시청",
        "경산시장"
      ],
      "duration_hours": 1.5
    },
    {
      "tour_name": "경산 도심 스카이라인 크루즈",
      "description": "영남대학교 → 남매탑 → 경산시장 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 경산의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "영남대학교",
