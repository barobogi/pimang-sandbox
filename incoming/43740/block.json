  "tours": [
    {
      "tour_name": "영동 역사·문화 시그니처 스카이 트레일",
      "description": "영동군청 → 영동시장 → 난계국악기제작촌 → 노근리평화공원 → 반야사 순으로 이어지는 충청북도 영동군의 대표 드론 플라이트 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "영동군청",
        "영동시장",
        "난계국악기제작촌",
        "노근리평화공원",
        "반야사"
      ],
      "duration_hours": 3.5
    },
    {
      "tour_name": "영동 고즈넉한 역사 스카이 산책",
      "description": "반야사 → 노근리평화공원 → 난계국악기제작촌 순의 역사·문화 집중 비행 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 영동의 역사·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "반야사",
        "노근리평화공원",
        "난계국악기제작촌"
      ],
      "duration_hours": 2.5
    },
    {
      "tour_name": "영동 도심 활력 에어리얼 코스",
      "description": "영동군청 → 영동시장 → 난계국악기제작촌 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 영동의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
