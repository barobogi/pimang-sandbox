  "tours": [
    {
      "tour_name": "영광 해안 절경 시그니처 드론 플라이트",
      "description": "백수해안 전망대 → 법성포 → 영광시장 → 영광군청 → 불갑사 순으로 이어지는 전라남도 영광군의 대표 드론 플라이트 코스. 파도 소리와 함께 해안선의 절경을 낮게 스치듯 비행하며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "백수해안 전망대",
        "법성포",
        "영광시장",
        "영광군청",
        "불갑사"
      ],
      "duration_hours": 3.5
    },
    {
      "tour_name": "영광 바다빛 스카이 세일",
      "description": "백수해안 전망대 → 법성포 → 영광시장 순의 해안 집중 비행 코스. 파도 소리와 함께 해안선의 절경을 낮게 스치듯 비행하며, 영광의 해안 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "백수해안 전망대",
        "법성포",
        "영광시장"
      ],
      "duration_hours": 2.5
    },
    {
      "tour_name": "영광 도심 활력 에어리얼 코스",
      "description": "영광시장 → 영광군청 → 불갑사 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 영광의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "영광시장",
        "영광군청",
        "불갑사"
      ],
      "duration_hours": 2.0
    }
  ],
