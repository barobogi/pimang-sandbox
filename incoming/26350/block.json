  "tours": [
    {
      "tour_name": "해운대 해안 절경 시그니처 드론 플라이트",
      "description": "달맞이길 → 해운대시장 → 해운대해수욕장 → 동백섬 → 센텀시티 순으로 이어지는 부산광역시 해운대구의 대표 드론 플라이트 코스. 파도 소리와 함께 해안선의 절경을 낮게 스치듯 비행하며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "달맞이길",
        "해운대시장",
        "해운대해수욕장",
        "동백섬",
        "센텀시티"
      ],
      "duration_hours": 2.5
    },
    {
      "tour_name": "해운대 푸른 해안선 에어리얼 크루즈",
      "description": "동백섬 → 해운대해수욕장 → 해운대시장 순의 해안 집중 비행 코스. 파도 소리와 함께 해안선의 절경을 낮게 스치듯 비행하며, 해운대의 해안 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "동백섬",
        "해운대해수욕장",
        "해운대시장"
      ],
      "duration_hours": 1.5
    },
    {
      "tour_name": "해운대 도심 스카이라인 크루즈",
      "description": "센텀시티 → 동백섬 → 해운대시장 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 해운대의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
