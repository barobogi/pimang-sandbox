  "tours": [
    {
      "tour_name": "옹진 해안 절경 시그니처 드론 플라이트",
      "description": "덕적도 → 자월도 → 대청도 → 연평도 → 백령도 순으로 이어지는 인천광역시 옹진군의 대표 드론 플라이트 코스. 파도 소리와 함께 해안선의 절경을 낮게 스치듯 비행하며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "덕적도",
        "자월도",
        "대청도",
        "연평도",
        "백령도"
      ],
      "duration_hours": 4.5
    },
    {
      "tour_name": "옹진 해안 절경 드론 플라이트",
