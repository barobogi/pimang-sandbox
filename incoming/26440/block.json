  "tours": [
    {
      "tour_name": "강서 자연 힐링 시그니처 에어리얼 투어",
      "description": "가덕도 → 을숙도생태공원 → 낙동강하구에코센터 → 지사문화마을 → 벚꽃공원 순으로 이어지는 부산광역시 강서구의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "가덕도",
        "을숙도생태공원",
        "낙동강하구에코센터",
        "지사문화마을",
        "벚꽃공원"
      ],
      "duration_hours": 3.5
    },
    {
      "tour_name": "강서 자연 힐링 스카이 워크",
      "description": "을숙도생태공원 → 낙동강하구에코센터 → 벚꽃공원 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 강서의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "을숙도생태공원",
        "낙동강하구에코센터",
        "벚꽃공원"
      ],
      "duration_hours": 2.0
    }
