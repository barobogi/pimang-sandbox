  "tours": [
    {
      "tour_name": "마포 자연 힐링 시그니처 에어리얼 투어",
      "description": "연남동 → 홍대입구 → 망원한강공원 → 서울월드컵경기장 → 난지한강공원 순으로 이어지는 서울특별시 마포구의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "연남동",
        "홍대입구",
        "망원한강공원",
        "서울월드컵경기장",
        "난지한강공원"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "마포 자연 힐링 스카이 워크",
      "description": "난지한강공원 → 망원한강공원 → 홍대입구 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 마포의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "난지한강공원",
        "망원한강공원",
        "홍대입구"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "마포 도심 하이라이트 스카이 투어",
      "description": "연남동 → 서울월드컵경기장 → 난지한강공원 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 마포의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "연남동",
        "서울월드컵경기장",
        "난지한강공원"
      ],
      "duration_hours": 2.0
    }
