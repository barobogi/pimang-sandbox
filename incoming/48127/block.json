  "tours": [
    {
      "tour_name": "마산회원 자연 힐링 시그니처 에어리얼 투어",
      "description": "회원동 상권 → 마산회원구청 → 마산역 상권 → 봉암갯벌 → 내서읍 상권 순으로 이어지는 경상남도 창원시 마산회원구의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "회원동 상권",
        "마산회원구청",
        "마산역 상권",
        "봉암갯벌",
        "내서읍 상권"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "마산회원 그린 랜드스케이프 플라이트",
      "description": "마산역 상권 → 마산회원구청 → 봉암갯벌 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 마산회원의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "마산역 상권",
        "마산회원구청",
        "봉암갯벌"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "마산회원 도심 스카이라인 크루즈",
      "description": "내서읍 상권 → 회원동 상권 → 마산회원구청 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 마산회원의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "내서읍 상권",
        "회원동 상권",
        "마산회원구청"
      ],
      "duration_hours": 2.0
    }
  ],
