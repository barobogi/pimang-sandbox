  "tours": [
    {
      "tour_name": "연제 자연 힐링 시그니처 에어리얼 투어",
      "description": "연산동 상권 → 배산 → 거제동 상권 → 부산아시아드주경기장 → 온천천 순으로 이어지는 부산광역시 연제구의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "연산동 상권",
        "배산",
        "거제동 상권",
        "부산아시아드주경기장",
        "온천천"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "연제 그린 랜드스케이프 플라이트",
      "description": "부산아시아드주경기장 → 연산동 상권 → 온천천 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 연제의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "부산아시아드주경기장",
        "연산동 상권",
        "온천천"
      ],
      "duration_hours": 2.0
    }
