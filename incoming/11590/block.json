  "tours": [
    {
      "tour_name": "동작 역사·문화 시그니처 스카이 트레일",
      "description": "중앙대학교 → 노들섬 → 노량진수산시장 → 보라매공원 → 국립서울현충원 순으로 이어지는 서울특별시 동작구의 대표 드론 플라이트 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "중앙대학교",
        "노들섬",
        "노량진수산시장",
        "보라매공원",
        "국립서울현충원"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "동작 역사문화 스카이 트레일",
