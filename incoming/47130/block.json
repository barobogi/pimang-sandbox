  "tours": [
    {
      "tour_name": "경주 역사·문화 시그니처 스카이 트레일",
      "description": "동궁과 월지 → 첨성대 → 대릉원 → 불국사 → 석굴암 순으로 이어지는 경상북도 경주시의 대표 드론 플라이트 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "동궁과 월지",
        "첨성대",
        "대릉원",
        "불국사",
        "석굴암"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "경주 역사문화 스카이 트레일",
      "description": "석굴암 → 불국사 → 첨성대 순의 역사·문화 집중 비행 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 경주의 역사·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "석굴암",
        "불국사",
        "첨성대"
      ],
      "duration_hours": 2.0
    }
  ],
