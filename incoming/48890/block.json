  "tours": [
    {
      "tour_name": "합천 자연 힐링 시그니처 에어리얼 투어",
      "description": "합천시장 → 합천군청 → 합천호 → 황매산 → 해인사 순으로 이어지는 경상남도 합천군의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "합천시장",
        "합천군청",
        "합천호",
        "황매산",
        "해인사"
      ],
      "duration_hours": 4.5
    },
    {
      "tour_name": "합천 자연 힐링 스카이 워크",
      "description": "황매산 → 합천호 → 합천시장 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 합천의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "황매산",
        "합천호",
        "합천시장"
      ],
      "duration_hours": 2.5
    },
    {
      "tour_name": "합천 도심 하이라이트 스카이 투어",
      "description": "합천군청 → 합천시장 → 합천호 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 합천의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "합천군청",
