  "tours": [
    {
      "tour_name": "강화 역사·문화 시그니처 스카이 트레일",
      "description": "강화평화전망대 → 강화산성 → 강화부두리고인돌 → 전등사 → 마니산 순으로 이어지는 인천광역시 강화군의 대표 드론 플라이트 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "강화평화전망대",
        "강화산성",
        "강화부두리고인돌",
        "전등사",
        "마니산"
      ],
      "duration_hours": 3.5
    },
    {
      "tour_name": "강화 고즈넉한 역사 스카이 산책",
      "description": "전등사 → 마니산 → 강화산성 순의 역사·문화 집중 비행 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 강화의 역사·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "전등사",
        "마니산",
        "강화산성"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "강화 산하 절경 에어리얼 투어",
      "description": "마니산 → 전등사 → 강화부두리고인돌 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 강화의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
