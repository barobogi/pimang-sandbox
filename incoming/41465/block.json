  "tours": [
    {
      "tour_name": "수지 도심 하이라이트 시그니처 스카이 투어",
      "description": "동천동 상권 → 수지공원 → 죽전동 카페거리 → 죽전역 상권 → 보정동 카페거리 순으로 이어지는 경기도 용인시 수지구의 대표 드론 플라이트 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "동천동 상권",
        "수지공원",
        "죽전동 카페거리",
        "죽전역 상권",
        "보정동 카페거리"
      ],
      "duration_hours": 2.5
    },
    {
      "tour_name": "수지 도심 스카이라인 크루즈",
      "description": "죽전역 상권 → 죽전동 카페거리 → 동천동 상권 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 수지의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "죽전역 상권",
        "죽전동 카페거리",
        "동천동 상권"
      ],
      "duration_hours": 1.5
    }
  ],
