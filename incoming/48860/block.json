  "tours": [
    {
      "tour_name": "산청 자연 힐링 시그니처 에어리얼 투어",
      "description": "산청시장 → 산청군청 → 동의보감촌 → 대원사 → 지리산 순으로 이어지는 경상남도 산청군의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "산청시장",
        "산청군청",
        "동의보감촌",
        "대원사",
        "지리산"
      ],
      "duration_hours": 3.5
    },
    {
      "tour_name": "산청 자연 힐링 스카이 워크",
      "description": "지리산 → 대원사 → 산청군청 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 산청의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "지리산",
        "대원사",
        "산청군청"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "산청 도심 하이라이트 스카이 투어",
      "description": "동의보감촌 → 산청군청 → 산청시장 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 산청의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "동의보감촌",
        "산청군청",
        "산청시장"
      ],
      "duration_hours": 2.0
    }
  ],
