  "tours": [
    {
      "tour_name": "달성 자연 힐링 시그니처 에어리얼 투어",
      "description": "비슬산 → 국립대구과학관 → 도동서원 → 사문진주막촌 → 옥포벚꽃길 순으로 이어지는 대구광역시 달성군의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "비슬산",
        "국립대구과학관",
        "도동서원",
        "사문진주막촌",
        "옥포벚꽃길"
      ],
      "duration_hours": 3.5
    },
    {
      "tour_name": "달성 자연 힐링 스카이 워크",
      "description": "옥포벚꽃길 → 비슬산 → 국립대구과학관 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 달성의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "옥포벚꽃길",
        "비슬산",
        "국립대구과학관"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "달성 도심 하이라이트 스카이 투어",
      "description": "국립대구과학관 → 비슬산 → 사문진주막촌 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 달성의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "국립대구과학관",
        "비슬산",
        "사문진주막촌"
      ],
      "duration_hours": 2.5
    }
