  "tours": [
    {
      "tour_name": "평창 자연 힐링 시그니처 에어리얼 투어",
      "description": "평창올림픽플라자 → 오대산 → 월정사 → 대관령 → 평창군청 순으로 이어지는 강원특별자치도 평창군의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "평창올림픽플라자",
        "오대산",
        "월정사",
        "대관령",
        "평창군청"
      ],
      "duration_hours": 4.5
    },
    {
      "tour_name": "평창 그린 랜드스케이프 플라이트",
      "description": "대관령 → 월정사 → 오대산 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 평창의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "대관령",
        "월정사",
        "오대산"
      ],
      "duration_hours": 2.5
    },
    {
      "tour_name": "평창 도심 스카이라인 크루즈",
      "description": "평창군청 → 평창올림픽플라자 → 오대산 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 평창의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "평창군청",
        "평창올림픽플라자",
        "오대산"
      ],
      "duration_hours": 3.0
    }
  ],
