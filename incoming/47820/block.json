  "tours": [
    {
      "tour_name": "청도 도심 하이라이트 시그니처 스카이 투어",
      "description": "청도소싸움경기장 → 청도천 → 청도군청 → 청도시장 → 운문사 순으로 이어지는 경상북도 청도군의 대표 드론 플라이트 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "청도소싸움경기장",
        "청도천",
        "청도군청",
        "청도시장",
        "운문사"
      ],
      "duration_hours": 3.5
    },
    {
      "tour_name": "청도 도심 하이라이트 스카이 투어",
      "description": "청도소싸움경기장 → 청도군청 → 청도시장 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 청도의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "청도소싸움경기장",
