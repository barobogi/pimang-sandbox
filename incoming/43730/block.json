  "tours": [
    {
      "tour_name": "옥천 자연 힐링 시그니처 에어리얼 투어",
      "description": "옥천시장 → 정지용 생가 → 향수공원 → 옥천군청 → 대청호 순으로 이어지는 충청북도 옥천군의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "옥천시장",
        "정지용 생가",
        "향수공원",
        "옥천군청",
        "대청호"
      ],
      "duration_hours": 3.5
    },
    {
      "tour_name": "옥천 그린 랜드스케이프 플라이트",
      "description": "대청호 → 정지용 생가 → 향수공원 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 옥천의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "대청호",
        "정지용 생가",
        "향수공원"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "옥천 도심 스카이라인 크루즈",
      "description": "옥천군청 → 향수공원 → 옥천시장 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 옥천의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "옥천군청",
        "향수공원",
        "옥천시장"
      ],
      "duration_hours": 2.0
    }
  ],
