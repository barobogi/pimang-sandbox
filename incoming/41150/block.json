  "tours": [
    {
      "tour_name": "의정부 도심 하이라이트 시그니처 스카이 투어",
      "description": "호수공원 → 의정부역 상권 → 의정부 경전철 → 자작공원 → 회룡역 상권 순으로 이어지는 경기도 의정부시의 대표 드론 플라이트 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "호수공원",
        "의정부역 상권",
        "의정부 경전철",
        "자작공원",
        "회룡역 상권"
      ],
      "duration_hours": 2.5
    },
    {
      "tour_name": "의정부 도심 스카이라인 크루즈",
      "description": "의정부 경전철 → 의정부역 상권 → 회룡역 상권 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 의정부의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "의정부 경전철",
        "의정부역 상권",
        "회룡역 상권"
      ],
      "duration_hours": 1.5
    },
    {
      "tour_name": "의정부 그린 랜드스케이프 플라이트",
      "description": "자작공원 → 의정부 경전철 → 호수공원 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 의정부의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
