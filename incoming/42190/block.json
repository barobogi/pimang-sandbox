  "tours": [
    {
      "tour_name": "태백 자연 힐링 시그니처 에어리얼 투어",
      "description": "매봉산 → 황지연못 → 태백시청 → 태백석탄박물관 → 태백산 순으로 이어지는 강원특별자치도 태백시의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "매봉산",
        "황지연못",
        "태백시청",
        "태백석탄박물관",
        "태백산"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "태백 자연 힐링 스카이 워크",
      "description": "태백산 → 황지연못 → 매봉산 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 태백의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "태백산",
