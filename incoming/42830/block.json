  "tours": [
    {
      "tour_name": "양양 해안 절경 시그니처 드론 플라이트",
      "description": "양양군청 → 남대천 → 낙산해수욕장 → 낙산사 → 죽도해수욕장 순으로 이어지는 강원특별자치도 양양군의 대표 드론 플라이트 코스. 파도 소리와 함께 해안선의 절경을 낮게 스치듯 비행하며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "양양군청",
        "남대천",
        "낙산해수욕장",
        "낙산사",
        "죽도해수욕장"
      ],
      "duration_hours": 3.5
    },
    {
      "tour_name": "양양 푸른 해안선 에어리얼 크루즈",
      "description": "죽도해수욕장 → 낙산해수욕장 → 낙산사 순의 해안 집중 비행 코스. 파도 소리와 함께 해안선의 절경을 낮게 스치듯 비행하며, 양양의 해안 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "죽도해수욕장",
        "낙산해수욕장",
        "낙산사"
      ],
      "duration_hours": 2.5
    }
  ],
