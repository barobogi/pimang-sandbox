  "tours": [
    {
      "tour_name": "수성 자연 힐링 시그니처 에어리얼 투어",
      "description": "아르떼뮤지엄 대구 → 황령산 → 수성갯벌체험장 → 수성못 → 국채보상운동기념공원 순으로 이어지는 대구광역시 수성구의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "아르떼뮤지엄 대구",
        "황령산",
        "수성갯벌체험장",
        "수성못",
        "국채보상운동기념공원"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "수성 산하 절경 에어리얼 투어",
      "description": "수성못 → 수성갯벌체험장 → 황령산 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 수성의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "수성못",
        "수성갯벌체험장",
        "황령산"
      ],
      "duration_hours": 1.5
    },
    {
      "tour_name": "수성 도심 활력 에어리얼 코스",
      "description": "아르떼뮤지엄 대구 → 황령산 → 수성갯벌체험장 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 수성의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "아르떼뮤지엄 대구",
        "황령산",
        "수성갯벌체험장"
      ],
      "duration_hours": 1.5
    }
