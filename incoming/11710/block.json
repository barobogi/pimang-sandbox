  "tours": [
    {
      "tour_name": "송파 역사·문화 시그니처 스카이 트레일",
      "description": "송리단길 → 석촌호수 → 롯데월드타워 → 롯데월드 어드벤처 → 몽촌토성 순으로 이어지는 서울특별시 송파구의 대표 드론 플라이트 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "송리단길",
        "석촌호수",
        "롯데월드타워",
        "롯데월드 어드벤처",
        "몽촌토성"
      ],
      "duration_hours": 2.5
    },
    {
      "tour_name": "송파 고즈넉한 역사 스카이 산책",
      "description": "몽촌토성 → 송리단길 → 롯데월드타워 순의 역사·문화 집중 비행 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 송파의 역사·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "몽촌토성",
        "송리단길",
        "롯데월드타워"
      ],
      "duration_hours": 1.5
    },
    {
      "tour_name": "송파 도심 활력 에어리얼 코스",
      "description": "롯데월드 어드벤처 → 롯데월드타워 → 석촌호수 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 송파의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
