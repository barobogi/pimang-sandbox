  "tours": [
    {
      "tour_name": "영양 자연 힐링 시그니처 에어리얼 투어",
      "description": "영양군청 → 영양시장 → 두들마을 → 일월산 → 영양반딧불이생태공원 순으로 이어지는 경상북도 영양군의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "영양군청",
        "영양시장",
        "두들마을",
        "일월산",
        "영양반딧불이생태공원"
      ],
      "duration_hours": 4.5
    },
    {
      "tour_name": "영양 산하 절경 에어리얼 투어",
      "description": "영양반딧불이생태공원 → 일월산 → 영양군청 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 영양의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "영양반딧불이생태공원",
        "일월산",
        "영양군청"
      ],
      "duration_hours": 2.5
    },
    {
      "tour_name": "영양 도심 활력 에어리얼 코스",
      "description": "영양군청 → 영양시장 → 두들마을 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 영양의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "영양군청",
