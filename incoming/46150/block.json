  "tours": [
    {
      "tour_name": "순천 역사·문화 시그니처 스카이 트레일",
      "description": "선암사 → 송광사 → 낙안읍성 → 순천만습지 → 순천만국가정원 순으로 이어지는 전라남도 순천시의 대표 드론 플라이트 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "선암사",
        "송광사",
        "낙안읍성",
        "순천만습지",
        "순천만국가정원"
      ],
      "duration_hours": 4.0
    },
    {
      "tour_name": "순천 고즈넉한 역사 스카이 산책",
      "description": "낙안읍성 → 선암사 → 송광사 순의 역사·문화 집중 비행 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 순천의 역사·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "낙안읍성",
        "선암사",
        "송광사"
      ],
      "duration_hours": 2.0
    }
  ],
