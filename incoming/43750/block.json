  "tours": [
    {
      "tour_name": "증평 자연 힐링 시그니처 에어리얼 투어",
      "description": "증평시장 → 증평군청 → 삼기저수지 → 좌구산천문대 → 좌구산 순으로 이어지는 충청북도 증평군의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "증평시장",
        "증평군청",
        "삼기저수지",
        "좌구산천문대",
        "좌구산"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "증평 자연 힐링 스카이 워크",
      "description": "좌구산 → 좌구산천문대 → 삼기저수지 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 증평의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "좌구산",
        "좌구산천문대",
        "삼기저수지"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "증평 도심 하이라이트 스카이 투어",
      "description": "증평군청 → 증평시장 → 삼기저수지 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 증평의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "증평군청",
        "증평시장",
        "삼기저수지"
      ],
      "duration_hours": 2.0
    }
