  "tours": [
    {
      "tour_name": "보은 역사·문화 시그니처 스카이 트레일",
      "description": "보은시장 → 보은군청 → 속리산 → 정이품송 → 법주사 순으로 이어지는 충청북도 보은군의 대표 드론 플라이트 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "보은시장",
        "보은군청",
        "속리산",
        "정이품송",
        "법주사"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "보은 세월을 나는 문화유산 플라이트",
      "description": "법주사 → 정이품송 → 속리산 순의 역사·문화 집중 비행 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 보은의 역사·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "법주사",
        "정이품송",
        "속리산"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "보은 도심 스카이라인 크루즈",
      "description": "보은시장 → 보은군청 → 속리산 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 보은의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
