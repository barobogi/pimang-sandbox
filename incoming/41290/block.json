  "tours": [
    {
      "tour_name": "과천 자연 힐링 시그니처 에어리얼 투어",
      "description": "국립과천과학관 → 서울대공원 → 정부과천청사 → 관악산 → 문원동 상권 순으로 이어지는 경기도 과천시의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "국립과천과학관",
        "서울대공원",
        "정부과천청사",
        "관악산",
        "문원동 상권"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "과천 그린 랜드스케이프 플라이트",
      "description": "서울대공원 → 국립과천과학관 → 관악산 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 과천의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "서울대공원",
        "국립과천과학관",
        "관악산"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "과천 도심 스카이라인 크루즈",
      "description": "정부과천청사 → 국립과천과학관 → 서울대공원 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 과천의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
