  "tours": [
    {
      "tour_name": "사상 도심 하이라이트 시그니처 스카이 투어",
      "description": "삼락생태공원 → 하단에코랜드 → 사상역 상권 → 모라동 상권 → 괴정동 상권 순으로 이어지는 부산광역시 사상구의 대표 드론 플라이트 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "삼락생태공원",
        "하단에코랜드",
        "사상역 상권",
        "모라동 상권",
        "괴정동 상권"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "사상 도심 스카이라인 크루즈",
      "description": "괴정동 상권 → 사상역 상권 → 모라동 상권 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 사상의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "괴정동 상권",
        "사상역 상권",
        "모라동 상권"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "사상 그린 랜드스케이프 플라이트",
      "description": "하단에코랜드 → 삼락생태공원 → 사상역 상권 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 사상의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "하단에코랜드",
        "삼락생태공원",
