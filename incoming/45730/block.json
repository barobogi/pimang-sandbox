  "tours": [
    {
      "tour_name": "무주 자연 힐링 시그니처 에어리얼 투어",
      "description": "무주구천동 → 설천봉 → 덕유산 → 태권도원 → 적상산성 순으로 이어지는 전북특별자치도 무주군의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "무주구천동",
        "설천봉",
        "덕유산",
        "태권도원",
        "적상산성"
      ],
      "duration_hours": 3.5
    },
    {
      "tour_name": "무주 그린 랜드스케이프 플라이트",
      "description": "덕유산 → 무주구천동 → 적상산성 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 무주의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "덕유산",
        "무주구천동",
        "적상산성"
      ],
      "duration_hours": 2.0
    }
