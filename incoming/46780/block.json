  "tours": [
    {
      "tour_name": "보성 역사·문화 시그니처 스카이 트레일",
      "description": "득량역 → 율포해수욕장 → 한국차박물관 → 대한다원 → 태백산맥문학관 순으로 이어지는 전라남도 보성군의 대표 드론 플라이트 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "득량역",
        "율포해수욕장",
        "한국차박물관",
        "대한다원",
        "태백산맥문학관"
      ],
      "duration_hours": 4.0
    },
    {
      "tour_name": "보성 세월을 나는 문화유산 플라이트",
      "description": "태백산맥문학관 → 한국차박물관 → 대한다원 순의 역사·문화 집중 비행 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 보성의 역사·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "태백산맥문학관",
        "한국차박물관",
        "대한다원"
      ],
      "duration_hours": 2.5
    },
    {
      "tour_name": "보성 도심 스카이라인 크루즈",
