  "tours": [
    {
      "tour_name": "동래 자연 힐링 시그니처 에어리얼 투어",
      "description": "온천천벚꽃길 → 충렬사 → 동래읍성 → 복천동고분군 → 금강공원 순으로 이어지는 부산광역시 동래구의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "온천천벚꽃길",
        "충렬사",
        "동래읍성",
        "복천동고분군",
        "금강공원"
      ],
      "duration_hours": 2.5
    },
    {
      "tour_name": "동래 산하 절경 에어리얼 투어",
      "description": "충렬사 → 온천천벚꽃길 → 금강공원 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 동래의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "충렬사",
        "온천천벚꽃길",
        "금강공원"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "동래 고즈넉한 역사 스카이 산책",
      "description": "복천동고분군 → 동래읍성 → 충렬사 순의 역사·문화 집중 비행 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 동래의 역사·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
