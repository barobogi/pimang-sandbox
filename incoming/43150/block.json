  "tours": [
    {
      "tour_name": "제천 자연 힐링 시그니처 에어리얼 투어",
      "description": "제천시청 → 제천역 상권 → 의림지 → 박달재 → 청풍호 순으로 이어지는 충청북도 제천시의 대표 드론 플라이트 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "제천시청",
        "제천역 상권",
        "의림지",
        "박달재",
        "청풍호"
      ],
      "duration_hours": 4.0
    },
    {
      "tour_name": "제천 산하 절경 에어리얼 투어",
      "description": "의림지 → 박달재 → 청풍호 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 제천의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "의림지",
        "박달재",
        "청풍호"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "제천 도심 활력 에어리얼 코스",
      "description": "제천역 상권 → 제천시청 → 의림지 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 제천의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "제천역 상권",
        "제천시청",
        "의림지"
      ],
      "duration_hours": 2.0
    }
  ],
