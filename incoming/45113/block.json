  "tours": [
    {
      "tour_name": "덕진 도심 하이라이트 시그니처 스카이 투어",
      "description": "덕진공원 → 전북대학교 → 덕진구청 → 전주천 → 전주월드컵경기장 순으로 이어지는 전북특별자치도 전주시 덕진구의 대표 드론 플라이트 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "덕진공원",
        "전북대학교",
        "덕진구청",
        "전주천",
        "전주월드컵경기장"
      ],
      "duration_hours": 3.0
    },
    {
      "tour_name": "덕진 도심 하이라이트 스카이 투어",
      "description": "전주월드컵경기장 → 전북대학교 → 덕진구청 순의 도심·문화 집중 비행 코스. 도심의 활기와 스카이라인을 부감으로 누비며, 덕진의 도심·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "전주월드컵경기장",
        "전북대학교",
        "덕진구청"
      ],
      "duration_hours": 2.0
    },
    {
      "tour_name": "덕진 자연 힐링 스카이 워크",
      "description": "전주천 → 덕진공원 → 전북대학교 순의 자연 집중 비행 코스. 사계절의 빛깔이 얹힌 자연 지형을 완만한 고도로 가르며, 덕진의 자연 매력을 밀도 있게 만나는 3스톱 투어다.",
