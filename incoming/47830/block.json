  "tours": [
    {
      "tour_name": "고령 역사·문화 시그니처 스카이 트레일",
      "description": "고령시장 → 고령군청 → 대가야박물관 → 지산동고분군 → 주산성 순으로 이어지는 경상북도 고령군의 대표 드론 플라이트 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 총 5곳의 랜드마크를 하나의 여정으로 감상한다.",
      "order": [
        "고령시장",
        "고령군청",
        "대가야박물관",
        "지산동고분군",
        "주산성"
      ],
      "duration_hours": 2.5
    },
    {
      "tour_name": "고령 고즈넉한 역사 스카이 산책",
      "description": "대가야박물관 → 지산동고분군 → 주산성 순의 역사·문화 집중 비행 코스. 천 년 세월이 층층이 쌓인 문화유산의 지붕선을 따라 날며, 고령의 역사·문화 매력을 밀도 있게 만나는 3스톱 투어다.",
      "order": [
        "대가야박물관",
